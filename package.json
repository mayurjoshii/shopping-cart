{
  "name": "pinder",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "dependencies": {
    "react": "^16.8.3",
    "react-dom": "^16.8.3",
    "react-scripts": "2.1.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "start": "PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:dev": "PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" concurrently \"BROWSER=none NODE_OPTIONS=--openssl-legacy-provider react-scripts start\" \"wait-on http://localhost:3000 && ELECTRON_DEV=true electron .\"",
    "electron:build": "PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" NODE_OPTIONS=--openssl-legacy-provider react-scripts build && electron-builder"
  },
  "build": {
    "appId": "com.pinder.app",
    "productName": "Pinder",
    "extends": null,
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": "dir"
    }
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
